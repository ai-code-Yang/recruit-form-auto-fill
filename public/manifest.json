{
  "manifest_version": 3,
  "name": "CampusApply-Agent",
  "version": "1.0",
  "description": "校招网申自动填表助手",
  "permissions": ["activeTab", "scripting", "storage","tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "点击我"
  }
}